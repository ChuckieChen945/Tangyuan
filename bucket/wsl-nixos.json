{
    "version": "2511.7.1",
    "description": "安装全新的NixOS-WSL",
    "homepage": "https://github.com/nix-community/NixOS-WSL",
    "license": "Freeware",
    "depends": ["ChuckieChen945_Tangyuan/wsl-customized"],
    "architecture": {
        "64bit": {
            "url": "https://github.com/nix-community/NixOS-WSL/releases/download/2511.7.1/nixos.wsl",
            "hash": "d73e9e776c4332748ad25a71fbbdf6f8bc02b3ccf52b6edaaf21444c39f448b5"
        }
    },
    "pre_install": ["ensure \"$persist_dir\\data\""],
    "installer": {
        "script": [
            "info \"Installing WSL distribution...\"",
            // TODO: 解决安装完后会直接进入的问题
            "wsl --install --from-file \"$dir\\nixos.wsl\" --name \"NixOS\" --location \"$persist_dir\\data\""
        ]
    },
    "post_install": [
        "Get-ChildItem -Path $dir -Recurse | Remove-Item -Force -ErrorAction SilentlyContinue -Recurse"
    ],
    "pre_uninstall": [],
    "uninstaller": {
        "script": ["wsl --unregister NixOS"]
    },
    "persist": "data",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/nix-community/NixOS-WSL/releases/download/$version/nixos.wsl"
            }
        }
    }
}
